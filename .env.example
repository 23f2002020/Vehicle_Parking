# Copy this file to ".env" and edit. It is loaded automatically by app.py and the Celery worker.
# Every line is optional - the defaults run fine on a laptop.

# ---- security (set both before you put this on a server) ----
# NOTE: the password salt is part of every stored password hash. Set it BEFORE the first start;
# if you change it later, existing accounts can no longer log in (delete instance/*.sqlite3 to start fresh).
# SECRET_KEY=change-me-to-a-long-random-string
# SECURITY_PASSWORD_SALT=change-me-too

# ---- environment ----
# development (default) | production   (production turns debug, demo data and the demo clock off)
APP_ENV=development
HOST=127.0.0.1
PORT=5000
# DATABASE_URL=sqlite:///vehicle_Parking.sqlite3
DEMO_MODE=true
SEED_DEMO_DATA=true
ALLOW_ADMIN_SIGNUP=true
PLATFORM_ADMIN_EMAIL=user@admin.com

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
# auto   = Celery when Redis answers, otherwise a background thread (recommended)
# celery = always Celery (errors if Redis is down)
# inline = never use Redis
TASK_MODE=auto
# auto | on | off  - the in-process scheduler used when Redis/beat are not running
EMBEDDED_SCHEDULER=auto

# ---- e-mail ----
# Leave MAIL_SERVER empty to write every e-mail to instance/outbox/ instead of sending it.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=VParkEasy <no-reply@example.com>

# ---- business rules ----
APP_TIMEZONE=Asia/Kolkata
BUFFER_MINUTES_DEFAULT=45
FINE_MULTIPLIER=1.5
FINE_GRACE_MINUTES=0
WELCOME_FREE_MINUTES=60
